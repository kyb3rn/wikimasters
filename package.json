{
  "name": "wikimasters",
  "version": "0.4.0",
  "description": "Outils pour wiki-masters.com, en un seul userscript Tampermonkey.",
  "author": "mamzet",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "dev": "node build.mjs --dev --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint .",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:e2e": "npm run build:dev && playwright test",
    "check": "npm run typecheck && npm run lint && npm run deps && npm run test && npm run test:e2e && npm run build",
    "captures:sanitize": "node test/tools/run.mjs test/tools/sanitize-captures.ts",
    "site:classes": "node test/tools/run.mjs test/tools/check-site-classes.ts"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dependency-cruiser": "^18.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
