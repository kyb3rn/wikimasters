# Fins de ligne LF sur le disque comme dans le dépôt (.gitattributes) : sous Windows, un éditeur
# écrirait sinon en CRLF.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Deux espaces en fin de ligne : saut de ligne en Markdown.
trim_trailing_whitespace = false
